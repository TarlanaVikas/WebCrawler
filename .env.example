# Web Crawler configuration. Copy to .env and adjust. Every value below is optional;
# the commented values are the defaults. There are no secrets or API keys in this project.

# --- Server ---
# WEBCRAWLER_HOST=127.0.0.1
# WEBCRAWLER_PORT=8000
# WEBCRAWLER_DB_PATH=crawler.db

# Extra Host header values accepted besides localhost, 127.0.0.1 and [::1] (comma separated).
# WEBCRAWLER_ALLOWED_HOSTS=
# Browser origins allowed to call the API from another origin (comma separated). Empty = same-origin only.
# WEBCRAWLER_CORS_ORIGINS=

# --- Safety ---
# Crawling loopback, private and link-local addresses is refused. Only enable this for local
# development or testing against your own machine.
# WEBCRAWLER_ALLOW_PRIVATE_NETWORKS=false

# --- Hard limits (requests above these values are rejected) ---
# WEBCRAWLER_MAX_DEPTH=8
# WEBCRAWLER_MAX_PAGES=1000
# WEBCRAWLER_MAX_CONCURRENCY=16
# WEBCRAWLER_MIN_DELAY=0.1
# WEBCRAWLER_MAX_RUNTIME=1800
# WEBCRAWLER_MAX_RESPONSE_BYTES=2097152

# --- Identification ---
# WEBCRAWLER_USER_AGENT=WebCrawler/1.0.0 (+local crawler; respects robots.txt)
